	/// Categorizes each order row into a price tier based on its unit price. Values are "High" if orders[UnitPrice] is greater than 500, and "Low" otherwise. Dependencies: orders[UnitPrice]. Use this field for segmentation, slicing, and filtering sales performance by product price tiers
	/// 
	column 'Price Category' =
			
			IF(
			    orders[UnitPrice] > 500,
			    "High",
			    "Low"
			)
		lineageTag: bee1a038-5b11-4f25-9019-fcbcc4f81107
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Segmenting column that categorizes each order row into tiered discount levels based on its discount percentage. Evaluates to "No Discount" if Orders[Discount] is 0, "Low Discount" if up to 10%, "Medium Discount" if up to 20%, and "High Discount" for anything above 20%. Dependencies: Orders[Discount]. Use this field for promotional analysis, customer behavior tracking, and slicing performance metrics across different discount tiers
	/// 
	column 'Discount Category' =
			
			SWITCH(
			    TRUE(),
			    'orders'[Discount] = 0, "No Discount",
			    'orders'[Discount] <= 0.10, "Low Discount",
			    'orders'[Discount] <= 0.20, "Medium Discount",
			    "High Discount"
			)
		lineageTag: 71ae7811-db02-4ac8-aa2b-eb8d40cb32de
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Segmenting column that indicates whether an order received a promotion. Evaluates to "Discounted" if Orders[Discount] is strictly greater than 0, and "No Discount" if it equals 0. Dependencies: Orders[Discount]. Use this field for filtering and analyzing promotional versus non-promotional order volume, sales, and profitability
	column Profit_Status = IF('orders'[Profit] > 0, "Profit", "Loss")
		lineageTag: f0412c18-aa22-499f-8311-e3dde91a3e70
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Calculates the net profit for each individual order row by subtracting undiscounted gross revenue from discounted revenue. Dependencies: orders[Quantity], orders[UnitPrice], orders[Discount]. Use this column for row-level profit analysis, distribution checks, or aggregations when a calculated column is specifically required
	column Profit =
			
			('orders'[Quantity] * 'orders'[UnitPrice] * (1 - 'orders'[Discount])) - ('orders'[Quantity] * 'orders'[UnitPrice])
		lineageTag: ca350580-ec05-422a-a750-97598bd92d1c
		summarizeBy: sum
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Segmenting column that categorizes each order row based on its financial outcome. Evaluates to "Profit" if Orders[Profit] is strictly greater than 0, and "Loss" otherwise. Dependencies: Orders[Profit]. Use this field for filtering, slicing, and analyzing order volume or sales distribution by profitable versus unprofitable transactions.
	/// 
	column 'Profit Status' = IF('orders'[Profit] > 0, "Profit", "Loss")
		lineageTag: 10721dc7-9ef1-4026-9f51-1187d7721f9b
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Calculates the gross sales revenue for each individual order row by multiplying unit price by quantity. Dependencies: orders[UnitPrice], orders[Quantity]. Use this column for row-level revenue analysis, distribution checks, or when a calculated column is specifically required.
	column 'Sales Per Order' = ('orders'[UnitPrice] * 'orders'[Quantity])
		lineageTag: e6f475a8-f77f-41ac-833c-d59efab4badf
		summarizeBy: sum
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the sales revenue per individual unit for each order row by dividing sales per order by quantity. Dependencies: orders[Sales Per Order], orders[Quantity]. Use this column for unit-level revenue analysis or pricing validations
	column 'Sales Per Unit' = ```
			
			DIVIDE(
			    'orders'[Sales Per Order], 
			    'orders'[Quantity]
			)
			```
		lineageTag: 326ad015-276f-4379-9a2a-765eb2ecc40b
		summarizeBy: sum
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Segmenting column that categorizes each order row based on its total sales value. Evaluates to "High Sales" if orders[Sales Per Order] is greater than or equal to 500, and "Low Sales" otherwise. Dependencies: orders[Sales Per Order]. Use this field for filtering, slicing, and analyzing order volume, distribution, or performance by sales tier
	column 'Sales Category' = IF(orders[Sales Per Order] >= 500, "High Sales", "Low Sales")
		lineageTag: af4da8ec-d509-46fa-93a7-ad6a7d603867
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Segmenting column that identifies high-value, profitable transactions. Evaluates to "Good Order" if orders[Sales Per Order] is strictly greater than 500 AND Orders[Profit] is strictly greater than 0, and "Other Order" otherwise. Dependencies: orders[Sales Per Order], Orders[Profit]. Use this field for filtering, slicing, and analyzing order performance by identifying top-performing, high-margin transactions
	column 'High Sales & Profit' =
			
			IF(
			    AND('orders'[Sales Per Order] > 500, 'orders'[Profit] > 0),
			    "Good Order",
			    "Other Order"
			)
		lineageTag: 1af21479-5d5d-43e5-aed7-22a9e3627d11
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

	/// Segmenting column that identifies potentially problematic or unprofitable transactions. Evaluates to "Risky" if Orders[Profit] is less than 0 OR Orders[Discount] is strictly greater than 0.20 (20%), and "Normal" otherwise. Dependencies: Orders[Profit], Orders[Discount]. Use this field for risk assessment, auditing unprofitable transactions, and analyzing the impact of heavy discounting
	column 'Risky Order' =
			
			IF(
			    OR('orders'[Profit] < 0, 'orders'[Discount] > 0.20),
			    "Risky",
			    "Normal"
			)
		lineageTag: 9f05516b-edf0-4491-8541-f9a550e3e1f2
		summarizeBy: none
		expressionContext: userContext

		changedProperty = Name

		changedProperty = Description

		annotation SummarizationSetBy = Automatic

