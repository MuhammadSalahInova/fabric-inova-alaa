	/// KPI card displaying total quantity sold (from measure [Total Quantity]), shown as a dark-themed styled HTML card with a package/box icon
	measure KPI_TotalQuantity =
			
			VAR _val = [Total Quantity]
			VAR _fmt =
			    SWITCH(
			        TRUE(),
			        _val >= 1000000, FORMAT(DIVIDE(_val,1000000),"0.00") & "M",
			        _val >= 1000, FORMAT(DIVIDE(_val,1000),"0") & "K",
			        FORMAT(_val,"0")
			    )
			VAR _html =
			"<style>
			.kpi-card {
			  position: relative;
			  background: #1A1E30;
			  border-radius: 12px;
			  padding: 20px;
			  box-sizing: border-box;
			  height: 100%;
			  display: flex;
			  flex-direction: column;
			  justify-content: center;
			  gap: 6px;
