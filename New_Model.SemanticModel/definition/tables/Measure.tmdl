			.geo-wrap {
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  background: #1A1E30;
			  border-radius: 12px;
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  overflow: hidden;
			}
			.geo-dot {
			  animation: dotPulse 2.4s ease-in-out infinite;
			  transform-origin: center;
			}
			@keyframes dotPulse {
			  0%, 100% { opacity: 0.75; r: 4.5; }
			  50% { opacity: 1; r: 6.5; }
			}
			</style>
			<div class='geo-wrap'>" & _svg & "</div>"
			RETURN _html
