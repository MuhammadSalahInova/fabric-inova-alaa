	/// Duplicate of KPI_TotalQuantity styled with a light background for the light theme version of the report
	measure KPI_TotalQuantity2 =
			
			VAR _val = [Total Quantity]
			VAR _fmt =
			    SWITCH(
			        TRUE(),
			        _val >= 1000000, FORMAT(DIVIDE(_val,1000000),"0.00") & "M",
			        _val >= 1000, FORMAT(DIVIDE(_val,1000),"0") & "K",
			        FORMAT(_val,"0")
			    )
			VAR _html =
			"<style>
			.kpi-card {
			  position: relative;
			  background: #FFFFFF;
			  border-radius: 12px;
			  padding: 20px;
			  box-sizing: border-box;
			  height: 100%;
			  display: flex;
			  flex-direction: column;
			  justify-content: center;
			  gap: 6px;
			  font-family: Arial, sans-serif;
			  animation: glowPulse 4s ease-in-out infinite;
			}
			@keyframes glowPulse {
			  0% { box-shadow: 0 0 34px 6px rgba(34,211,238,0.55); }
			  33% { box-shadow: 0 0 34px 6px rgba(139,92,246,0.55); }
			  66% { box-shadow: 0 0 34px 6px rgba(236,72,153,0.55); }
			  100% { box-shadow: 0 0 34px 6px rgba(34,211,238,0.55); }
			}
			.kpi-icon {
			  position: absolute;
			  top: 14px;
			  right: 16px;
			  width: 34px;
			  height: 34px;
			  animation: bounceIcon 2.2s ease-in-out infinite;
			}
			@keyframes bounceIcon {
			  0%, 100% { transform: translateY(0); }
			  50% { transform: translateY(-6px); }
			}
			.kpi-label {
			  font-size: 30px;
			  color: #4A4F63;
			}
			.kpi-value {
			  font-size: 34px;
			  font-weight: 700;
			  background: linear-gradient(90deg, #22D3EE, #8B5CF6, #EC4899, #8B5CF6, #22D3EE);
			  background-size: 300% 100%;
			  -webkit-background-clip: text;
			  background-clip: text;
			  color: transparent;
			  animation: gradientShift 6s ease-in-out infinite;
			}
			@keyframes gradientShift {
			  0% { background-position: 0% 50%; }
			  50% { background-position: 100% 50%; }
			  100% { background-position: 0% 50%; }
			}
			</style>
			<div class='kpi-card'>
			  <svg class='kpi-icon' viewBox='0 0 24 24'>
			    <defs>
			      <linearGradient id='g1' x1='0' y1='0' x2='1' y2='1'>
			        <stop offset='0%' stop-color='#22D3EE'/>
			        <stop offset='50%' stop-color='#8B5CF6'/>
			        <stop offset='100%' stop-color='#EC4899'/>
			      </linearGradient>
			    </defs>
			    <path fill='none' stroke='url(#g1)' stroke-width='1.6' stroke-linejoin='round' d='M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z'/>
			    <path fill='none' stroke='url(#g1)' stroke-width='1.6' stroke-linejoin='round' d='M3 7.5 12 12l9-4.5M12 12v9'/>
			  </svg>
			  <span class='kpi-label'>Total Quantity</span>
			  <span class='kpi-value'>" & _fmt & "</span>
			</div>"
			RETURN _html
		lineageTag: 2e48e0d2-9876-4e4c-ba88-817963266c1a

