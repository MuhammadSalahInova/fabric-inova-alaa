	measure NavCard_overView2 =
			
			VAR _html =
			"<style>
			  .card-wrap {
			    position: fixed;
			    inset: 0;
			    margin: 0;
			    padding: 18px;
			    box-sizing: border-box;
			    display: flex;
			    align-items: center;
			    justify-content: center;
			    background: #FFFFFF;
			  }
			  .card {
			    position: relative;
			    width: 100%;
			    height: 100%;
			    box-sizing: border-box;
			    background-color: #FFFFFF;
			    display: flex;
			    flex-direction: column;
			    justify-content: flex-start;
			    padding: 28px;
			    gap: 12px;
			    border-radius: 8px;
			    cursor: pointer;
			    color: #1A1E30;
			  }
			  .card::before {
			    content: '';
			    position: absolute;
			    inset: -16px;
			    border-radius: 14px;
			    background: linear-gradient(-45deg, #22D3EE 0%, #8B5CF6 50%, #EC4899 100%);
			    z-index: -10;
			    pointer-events: none;
			    transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			  }
			  .card::after {
			    content: '';
			    z-index: -1;
			    position: absolute;
			    inset: -16px;
			    background: linear-gradient(-45deg, #0EA5C7 0%, #7C3AED 50%, #DB2777 100%);
			    transform: translate3d(0, 0, 0) scale(0.95);
			    filter: blur(26px);
			  }
			  .num {
			    font-size: 14px;
			    color: #8F96B2;
			    margin: 0;
			  }
			  .heading {
			    display: flex;
			    align-items: center;
			    gap: 10px;
			    font-size: 32px;
			    text-transform: capitalize;
			    font-weight: 500;
			    margin: 0;
			    line-height: 1.25;
			    color: #1A1E30;
			  }
			  .heading-icon {
