	measure 'Max Discount Per Category' =
			
			CALCULATE(
			    MAXX(
			        orders,
			        orders[Discount]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cfb8689d-9132-4d41-9c80-93a81018eafe

	/// Total sales value for the same period one year ago, using SAMEPERIODLASTYEAR on the Date table. Used as the base comparison for YoY Growth.
	measure 'Sales Last Year' = ```
			CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[FullDate]))
			
			
			```
		lineageTag: 25f4bfed-1ebe-4fd8-97df-7a64d30333f0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 4c45061f-01b1-4d7c-8325-5cb2de0b2b0c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Measure = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 63955a49789047a884a2dc141403251a

