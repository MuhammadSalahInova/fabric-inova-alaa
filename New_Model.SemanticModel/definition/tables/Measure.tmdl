	measure Btn_Sales2 =
			
			VAR _html =
			"<style>
			.glass-btn-outer {
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  padding: 3px;
			  border-radius: 999px;
			  background: linear-gradient(90deg, #22D3EE, #8B5CF6, #EC4899, #8B5CF6, #22D3EE);
			  background-size: 300% 100%;
			  animation: gradientShift 6s ease-in-out infinite;
			}
			@keyframes gradientShift {
			  0% { background-position: 0% 50%; }
			  50% { background-position: 100% 50%; }
			  100% { background-position: 0% 50%; }
			}
			.glass-btn-inner {
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  background: #FFFFFF;
			  border-radius: 999px;
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  gap: 16px;
			  padding: 10px 20px;
			}
			.glass-btn-inner a {
			  display: flex;
			  align-items: center;
			  gap: 14px;
			  color: #1A1E30;
			  text-decoration: none;
			}
			.glass-btn-inner svg {
			  width: 42px;
			  height: 42px;
			  flex-shrink: 0;
			  fill: currentColor;
			}
			.glass-btn-inner span {
			  font-family: Arial, sans-serif;
			  font-size: 26px;
			  font-weight: 700;
			  line-height: 1;
			  white-space: nowrap;
			  color: #1A1E30;
			}
			</style>
			<div class='glass-btn-outer'>
			  <div class='glass-btn-inner'>
			    <a href='#'>
			      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
			        <path d='M3 17l6-6 4 4 8-8'/>
			        <path d='M17 7h4v4'/>
			      </svg>
			      <span>Sales Overview</span>
			    </a>
			  </div>
			</div>"
			RETURN _html
		lineageTag: 05da15d9-116c-4195-aa91-55f5e9169c24

