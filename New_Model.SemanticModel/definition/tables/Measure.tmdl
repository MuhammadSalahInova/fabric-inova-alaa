	measure Switch_ToLight =
			
			VAR _html =
			"<style>
			.switch-wrap {
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  width: 100%;
			  height: 100%;
			}
			.switch-track {
			  position: relative;
			  width: 90px;
			  height: 46px;
			  border-radius: 999px;
			  background: linear-gradient(135deg, #FFD8A8, #A8D8FF, #7EC8F0);
			  overflow: hidden;
			  transition: transform 0.3s ease;
			}
			.switch-track:hover {
			  transform: scale(1.06);
			}
			.cloud {
			  position: absolute;
			  background: #FFFFFF;
			  border-radius: 50%;
			  opacity: 0.55;
			}
			.cloud1 { width: 26px; height: 26px; top: 10px; right: 14px; }
			.cloud2 { width: 34px; height: 34px; top: 16px; right: 4px; opacity: 0.6; }
			.cloud3 { width: 20px; height: 20px; top: 20px; right: 22px; opacity: 0.5; }
			.switch-knob {
			  position: absolute;
			  top: 4px;
			  left: 4px;
			  width: 38px;
			  height: 38px;
			  border-radius: 50%;
			  background: radial-gradient(circle at 35% 35%, #FFFFFF, #E8E8E8);
			  transition: left 0.3s ease;
			}
			</style>
			<div class='switch-wrap'>
			  <div class='switch-track'>
			    <div class='cloud cloud2'></div>
			    <div class='cloud cloud1'></div>
			    <div class='cloud cloud3'></div>
			    <div class='switch-knob'></div>
			  </div>
			</div>"
			RETURN _html
		lineageTag: ff205953-d712-40e2-847d-9a73f14224c3

	measure Switch_ToDark =
			
			VAR _html =
			"<style>
			.switch-wrap {
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  width: 100%;
			  height: 100%;
