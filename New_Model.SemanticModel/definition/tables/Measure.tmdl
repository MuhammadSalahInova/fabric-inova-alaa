table Measure
	lineageTag: 442265b6-702c-4b5c-a899-bc2da0608cff

	/// Total shipping costs paid for orders.
	measure 'Total Freight' =
			
			SUMX(
			    VALUES(orders[OrderID]),
			    CALCULATE(MAX(orders[Freight]))
			)
		lineageTag: 996ab701-1f86-4c09-ae35-edc500658b1e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total number of unique requests that were executed.
	/// 
	measure 'Total Orders' = DISTINCTCOUNT(orders[OrderID])
		formatString: 0
		lineageTag: 2735f8b5-883a-45ad-9c18-edbc2f72e487

	/// Average discount percentage applied across orders
	/// 
	measure 'Average Discount' = AVERAGE(orders[Discount])
		lineageTag: 3843ed8c-3505-44b3-b295-2e8cdc3b029d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average total value of a single order
	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders])
		lineageTag: 026a39a8-3fa2-4625-8c00-6d078cc59b5a

	/// This represents the total net revenue from sales after deducting discounts.
	measure 'Total Revenue' = SUM(orders[UnitPrice])
		lineageTag: 2994a8d0-1071-4096-8d90-fa50822e14ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates total sales revenue across all rows in the 'orders' table by iterating row-by-row and multiplying quantity by unit price (Quantity * UnitPrice). Dependencies: orders[Quantity], orders[UnitPrice]. Use this measure for overall revenue analysis, sales trends, and performance tracking
	measure 'Total Sales' = SUMX('orders', 'orders'[Quantity] * 'orders'[UnitPrice])
		lineageTag: 6842a5ed-6765-41d1-b645-175b11ce12b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the percentage of total profit relative to total sales ([Total Profit] / [Total Sales]).
	/// 
	measure 'Profit Margin %' =
			
			DIVIDE(
			    [Total Profit],
			    [Total Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 89bc857d-ec74-4563-a13a-0981b8e1ffaa

	/// Calculates the proportion of orders that resulted in a profit by dividing the count of profitable orders by the total order count. Dependencies: orders[Profit Status], orders[OrderID]. Use this measure for profitability success rate analysis
	measure 'Pct Profitable Orders' =
			
			DIVIDE(
			    CALCULATE(COUNT('orders'[OrderID]), 'orders'[Profit Status] = "Profit"),
			    COUNT('orders'[OrderID])
			)
		lineageTag: e4263e30-6049-4b85-b6b7-894d2f9e8171

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the total count of order rows that meet high-performance criteria, specifically having a sales per order value greater than 500 AND a profit greater than 100. Dependencies: Orders, orders[Sales Per Order], Orders[Profit]. Use this measure for analyzing the volume of high-value, high-profit transactions
	measure 'Strong Orders' =
			
			COUNTROWS(
			    FILTER(
			        'orders',
			        AND('orders'[Sales Per Order] > 500, 'orders'[Profit] > 100)
			    )
			)
		formatString: 0
		lineageTag: c299d40d-d193-4079-96f8-fdae08e62bf8

	/// Calculates the total gross sales revenue specifically for orders that received a discount (Orders[Discount] > 0). Dependencies: orders[Sales Per Order], Orders[Discount]. Use this measure for analyzing promotional revenue performance, comparing discounted versus non-discounted sales, and evaluating marketing campaign impact
	/// 
	measure 'Sales with Discount' =
			
			CALCULATE(
			    SUM('orders'[Sales Per Order]),
			    'orders'[Discount] > 0
			)
		lineageTag: 32978488-5953-4179-a5dd-ba59748328cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates Year-to-Date (YTD) total sales by aggregating sales from the beginning of the calendar year up to the current date context using the Date calendar dimension. Dependencies: orders[Sales Per Order], Date[FullDate]. Use this measure for annual performance tracking and year-over-year time intelligence analysis.
	/// 
	measure 'Sales YTD using DATESYTD' =
			
			CALCULATE(
			    SUM(orders[Sales Per Order]),
			    DATESYTD('Date'[FullDate])
			)
		lineageTag: 5c626977-be01-4e36-951a-abbc2d6fb376

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates Month-to-Date (MTD) total sales by aggregating sales from the start of the current month up to the current date context using the Date calendar dimension. Dependencies: orders[Sales Per Order], Date[FullDate]. Use this measure for tracking monthly sales performance and short-term trends.
	/// 
	measure 'Sales MTD' =
			
			CALCULATE(
			    SUM(orders[Sales Per Order]),
			    DATESMTD('Date'[FullDate])
			)
		lineageTag: 063ba6f2-62b1-4785-bc7d-ba902a913cf9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates Quarter-to-Date (QTD) total sales by aggregating sales from the beginning of the current quarter up to the current date context using the Date calendar dimension. Dependencies: orders[Sales Per Order], Date[FullDate]. Use this measure for quarterly financial reviews and periodic trend analysis.
	measure 'Sales QTD' =
			
			CALCULATE(
			    SUM(orders[Sales Per Order]),
			    DATESQTD('Date'[FullDate])
			)
		lineageTag: d9fa1060-bf54-411f-82ed-89421ff7c625

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total quantity of items sold across all orders
	measure 'Total Quantity' = SUM('orders'[Quantity])
		formatString: 0
		lineageTag: 8e6db67d-a176-41f0-b6b7-d5810fb798a6

	/// Count of unique customers based on distinct contact names
	measure 'Unique Customers' = DISTINCTCOUNT(customer[ContactName])
		formatString: 0
		lineageTag: 75c02685-3345-4014-b1c5-15457134ddc0

	/// Average sales value across orders
	measure 'Average Sales' = AVERAGE(orders[Sales Category])
		formatString: 0
		lineageTag: 47ccf64c-f234-4858-95f7-4b35257ac97d

	/// Named "Total Profit" but the formula actually computes the absolute total discount amount given (Quantity × UnitPrice × Discount), not true profit (which would require cost data). Verify calculation logic before using for profit analysis.
	measure 'Total Profit' = ```
			
			ABS(
			    SUMX(
			        'orders', 
			        ('orders'[Quantity] * 'orders'[UnitPrice] * (1 - 'orders'[Discount])) - ('orders'[Quantity] * 'orders'[UnitPrice])
			    )
			)
			```
		lineageTag: d95c1500-f243-4d1f-9aed-34e599a1a795

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Risky Orders Count' =
			
			CALCULATE(
			    COUNTROWS(orders),
			    orders[Profit] < 0 || orders[Discount] > 0.20
			)
		formatString: 0
		lineageTag: 23401878-b9ac-415f-9223-658df562d479

	/// Percentage contribution of each product category to total sales
	measure 'Category Contribution %' =
			
			DIVIDE(
			    [Total Sales],
			    CALCULATE(
			        [Total Sales],
			        ALL('product'[CategoryName])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ab8bcf00-b73a-4de4-b8f4-7836e97f838f

	measure 'Profitable Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        'orders',
			        'orders'[Profit] > 0
			    )
			)
		lineageTag: 4524976e-d680-4cdf-907a-395f5a599644

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of unique territories/regions represented in the data
	measure 'Distinct Regions' =
			
			COUNTROWS(
			    DISTINCT(customer[Region])
			)
		formatString: 0
		lineageTag: 5a27ddf8-c818-4e94-b909-0c5e707707cd

	measure 'Sales Keep Region' =
			
			CALCULATE(
			    [Total Sales],
			    ALLEXCEPT(
			        Orders,
			        customer[Region]
			    )
			)
		lineageTag: 3b7abd39-f5ba-4615-8912-df7da705c663

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total sales value after applying discount, calculated as Sales Per Order minus discount, summed across all orders
	measure 'Net Sales' =
			
			SUMX(
			    'orders',
			    'orders'[Sales Per Order] * (1 - 'orders'[Discount])
			)
		lineageTag: cbe4c5bf-732e-4b5b-8bb9-7df2f04ac126

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Profit Margin' =
			
			MAXX(
			    'orders',
			    DIVIDE('orders'[Profit], [Total Sales])
			)
		lineageTag: 35993141-b8c7-4c04-b9f4-77437e3bcf17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min Profit Margin' =
			
			MINX(
			    'orders',
			    DIVIDE('orders'[Profit], [Total Sales])
			)
		lineageTag: f8328033-ec9e-44d7-934e-4918dc8c6b26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average profit margin percentage across orders
	measure 'Avg Profit Margin' = ```
			
			AVERAGEX(
			    orders, 
			    ABS(DIVIDE(orders[Profit], orders[Sales Per Order]))
			)
			```
		lineageTag: 105ffadd-76f0-4127-951b-6d04dba9d091

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Absolute difference in total sales between this year and last year (Total Sales - Sales Last Year, calculated using SAMEPERIODLASTYEAR). This is a value difference, not a percentage growth rate.
	measure 'YoY Growth' =
			
			[Total Sales] - [Sales Last Year]
		lineageTag: 83635bb1-14c6-4512-adb6-ce9474fb5188

	measure 'Sales by Category Visual' =
			
			
			VAR _Categories =
			    ADDCOLUMNS(
			        ALLSELECTED('product'[CategoryName]),
			        "SalesValue",
			        CALCULATE([Total Sales])
			    )
			
			VAR _MaxSales =
			    MAXX(
			        _Categories,
			        [SalesValue]
			    )
			
			VAR _TopCategories =
			    TOPN(
			        5,
			        _Categories,
			        [SalesValue],
			        DESC
			    )
			
			RETURN
			
			"<style>
			
			.sales-chart{
			    font-family:Segoe UI,sans-serif;
			    width:100%;
			    height:100%;
			    padding:16px;
			    box-sizing:border-box;
			    background:#1A1E30;
			    border-radius:12px;
			}
			
			.title{
			    font-size:16px;
			    font-weight:700;
			    color:#FFFFFF;
			    margin-bottom:3px;
			}
			
			.subtitle{
			    font-size:11px;
			    color:#8F96B2;
			    margin-bottom:18px;
			}
			
			.row{
			    display:flex;
			    align-items:center;
			    margin-bottom:13px;
			}
			
			.label{
			    width:110px;
			    font-size:11px;
			    color:#D5D8E5;
			    text-align:right;
			    padding-right:10px;
			    white-space:nowrap;
			}
			
			.bar-area{
			    flex:1;
			    height:14px;
			    background:#252A40;
			    border-radius:4px;
			    overflow:hidden;
			}
			
			.bar{
			    height:100%;
			    background:linear-gradient(
			        90deg,
			        #22D3EE 0%,
			        #3B82F6 35%,
			        #8B5CF6 70%,
			        #EC4899 100%
			    );
			    border-radius:4px;
			    box-shadow:0 0 8px rgba(59,130,246,0.35);
			}
			
			.value{
			    width:60px;
			    padding-left:8px;
			    font-size:10px;
			    color:#FFFFFF;
			    font-weight:600;
			}
			
			</style>
			
			<div class='sales-chart'>
			
			<div class='title'>Total Sales</div>
			
			<div class='subtitle'>by Category</div>"
			
			&
			
			CONCATENATEX(
			
			    _TopCategories,
			
			    VAR _Category =
			        'product'[CategoryName]
			
			    VAR _Sales =
			        [SalesValue]
			
			    VAR _Width =
			        DIVIDE(
			            _Sales,
			            _MaxSales,
			            0
			        ) * 100
			
			    RETURN
			
			    "<div class='row'>
			
			        <div class='label'>"
			        & _Category &
			        "</div>
			
			        <div class='bar-area'>
			
			            <div class='bar'
			            style='width:"
			            & FORMAT(_Width,"0.0")
			            & "%'>
			            </div>
			
			        </div>
			
			        <div class='value'>"
			        & FORMAT(_Sales/1000000,"0.00")
			        & "M
			        </div>
			
			    </div>",
			
			    ""
			
			)
			
			&
			
			"</div>"
		lineageTag: bb0a7734-90ea-457a-aeb0-502910a3474f

	/// Duplicate calculation identical to "Net Sales" and "Total_Profit" — computes UnitPrice × Quantity × (1 - Discount). Candidate for consolidation.
	measure Total_Sales =
			
			SUMX(
			    orders,
			    orders[UnitPrice] * orders[Quantity] * (1 - orders[Discount])
			)
		lineageTag: f5d4df4a-2b50-43a4-994c-614cb99a9751

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Named "Total_Profit" but the formula actually computes net sales after discount (UnitPrice × Quantity × (1 - Discount)), duplicating the "Net Sales" measure. Not true profit — no cost data is subtracted. Candidate for consolidation.
	measure Total_Profit =
			
			SUMX(
			    orders,
			    (orders[UnitPrice] * orders[Quantity]) - (orders[UnitPrice] * orders[Quantity] * orders[Discount])
			)
		lineageTag: 7f8911ae-b814-49e4-ba65-3882b8f941a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure NavCard_overView =
			
			VAR _html =
			"<style>
			  .card-wrap {
			    position: fixed;
			    inset: 0;
			    margin: 0;
			    padding: 18px;
			    box-sizing: border-box;
			    display: flex;
			    align-items: center;
			    justify-content: center;
			    background: #1E2235;
			  }
			  .card {
			    position: relative;
			    width: 100%;
			    height: 100%;
			    box-sizing: border-box;
			    background-color: #1E2235;
			    display: flex;
			    flex-direction: column;
			    justify-content: flex-start;
			    padding: 28px;
			    gap: 12px;
			    border-radius: 8px;
			    cursor: pointer;
			    color: white;
			  }
			  .card::before {
			    content: '';
			    position: absolute;
			    inset: -16px;
			    border-radius: 14px;
			    background: linear-gradient(-45deg, #22D3EE 0%, #8B5CF6 50%, #EC4899 100%);
			    z-index: -10;
			    pointer-events: none;
			    transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
			  }
			  .card::after {
			    content: '';
			    z-index: -1;
			    position: absolute;
			    inset: -16px;
			    background: linear-gradient(-45deg, #0EA5C7 0%, #7C3AED 50%, #DB2777 100%);
			    transform: translate3d(0, 0, 0) scale(0.95);
			    filter: blur(26px);
			  }
			  .num {
			    font-size: 14px;
			    color: #a8a8a8;
			    margin: 0;
			  }
			  .heading {
			    display: flex;
			    align-items: center;
			    gap: 10px;
			    font-size: 32px;
			    text-transform: capitalize;
			    font-weight: 500;
			    margin: 0;
			    line-height: 1.25;
			  }
			  .heading-icon {
			    flex-shrink: 0;
			  }
			  .card p.desc {
			    font-size: 18px;
			    color: #c8c8c8;
			    line-height: 1.6;
			    margin: 0;
			  }
			  .card:hover::after {
			    filter: blur(34px);
			  }
			  .card:hover::before {
			    transform: rotate(-90deg) scaleX(1.34) scaleY(0.77);
			  }
			</style>
			<div class='card-wrap'>
			  <div class='card'>
			    <p class='num'>01</p>
			    <p class='heading'><svg class='heading-icon' width='34' height='34' viewBox='0 0 24 24'><circle cx='12' cy='12' r='10' fill='#F5B942'/><text x='12' y='16' font-size='12' text-anchor='middle' fill='#7A4B00' font-family='Arial' font-weight='bold'>$</text></svg>Sales OverView</p>
			    <p class='desc'>Track total quantity, sales, and freight, and spot
			risky orders at a glance. Compare category
			performance, explore geographic sales
			distribution, and follow trends for top products.
			</p>
			  </div>
			</div>"
			RETURN _html
		lineageTag: 5a77a971-d9b0-4546-a362-906918039be3

	measure me = ```
			<style>
			.menu {
			  width: calc(100% - 20px);
			  max-width: 520px;
			  padding: 8px;
			
			  display: flex;
			  justify-content: center;
			  gap: 8px;
			
			  background: rgba(0, 122, 255, 0.40);
			  border: 1px solid rgba(255, 255, 255, 0.35);
			  border-radius: 999px;
			
			  backdrop-filter: blur(12px) saturate(180%) contrast(200%);
			  -webkit-backdrop-filter: blur(12px) saturate(180%) contrast(200%);
			
			  box-shadow:
			    0 10px 30px rgba(0, 0, 0, 0.08),
			    inset 2px 2px 5px -2px rgba(255, 255, 255, 0.4),
			    inset -2px -2px 5px 2px rgba(255, 255, 255, 0.25);
			
			  box-sizing: border-box;
			}
			
			/* Glass highlight */
			.menu::after {
			  content: "";
			  position: absolute;
			  inset: 0;
			
			  border-radius: inherit;
			
			  box-shadow:
			    inset 2px 2px 5px -2px rgba(255, 255, 255, 0.45),
			    inset -2px -2px 5px 2px rgba(255, 255, 255, 0.35),
			    inset 0 -2px 0 rgba(255, 255, 255, 0.20);
			
			  pointer-events: none;
			}
			
			/* Items */
			.menu a {
			  display: flex;
			  flex-direction: column;
			  align-items: center;
			  justify-content: center;
			
			  flex: 1 1 0;
			  min-width: 0;
			
			  padding: 10px 6px;
			
			  color: rgba(255, 255, 255, 0.92);
			  text-decoration: none;
			
			  border-radius: 999px;
			
			  transition:
			    background 0.2s ease,
			    color 0.2s ease,
			    transform 0.2s ease,
			    box-shadow 0.25s ease;
			
			  cursor: pointer;
			}
			
			/* Icon */
			.menu a svg {
			  width: 25px;
			  height: 25px;
			
			  margin-bottom: 4px;
			
			  fill: currentColor;
			
			  transition:
			    transform 0.2s ease,
			    filter 0.2s ease;
			}
			
			/* Text */
			.menu a span {
			  font-family: Arial, sans-serif;
			
			  font-size: 12px;
			  font-weight: 600;
			
			  line-height: 1;
			}
			
			/* Hover */
			.menu a:hover {
			  background: rgba(255, 255, 255, 0.28);
			
			  color: rgba(0, 92, 220, 0.90);
			
			  box-shadow:
			    inset 2px 2px 5px -2px rgba(255, 255, 255, 0.5),
			    inset -2px -1px 5px rgba(255, 255, 255, 0.35);
			
			  transform: translateY(-1px);
			}
			
			.menu a:hover svg {
			  transform: scale(1.08);
			}
			
			/* Active item */
			.menu a.active {
			  background: rgba(245, 248, 255, 0.72);
			
			  color: rgba(0, 102, 230, 0.95);
			
			  box-shadow:
			    inset 2px 2px 5px -2px rgba(255, 255, 255, 0.8),
			    inset -2px -2px 5px rgba(255, 255, 255, 0.35),
			    0 2px 8px rgba(0, 90, 220, 0.12);
			}
			
			/* Active icon */
			.menu a.active svg {
			  filter: drop-shadow(0 2px 3px rgba(0, 100, 255, 0.18));
			}
			
			/* Click */
			.menu a:active {
			  transform: scale(0.97);
			}
			</style>
			
			
			<div class="menu">
			
			  <!-- HOME -->
			  <a href="#" class="active">
			
			    <svg
			      xmlns="http://www.w3.org/2000/svg"
			      viewBox="0 0 24 24"
			      fill="currentColor"
			    >
			      <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z"/>
			      
			      <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z"/>
			    </svg>
			
			    <span>Home</span>
			  </a>
			
			
			  <!-- FILES -->
			  <a href="#">
			
			    <svg
			      xmlns="http://www.w3.org/2000/svg"
			      viewBox="0 0 24 24"
			      fill="currentColor"
			    >
			      <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z"/>
			    </svg>
			
			    <span>Files</span>
			  </a>
			
			
			  <!-- PLANS -->
			  <a href="#">
			
			    <svg
			      xmlns="http://www.w3.org/2000/svg"
			      viewBox="0 0 24 24"
			      fill="currentColor"
			    >
			      <path
			        fill-rule="evenodd"
			        d="M6.75 2.25A.75.75 0 0 1 7.5 3v1.5h9V3A.75.75 0 0 1 18 3v1.5h.75a3 3 0 0 1 3 3v11.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V7.5a3 3 0 0 1 3-3H6V3a.75.75 0 0 1 .75-.75Zm13.5 9a1.5 1.5 0 0 0-1.5-1.5H5.25a1.5 1.5 0 0 0-1.5 1.5v7.5a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5v-7.5Z"
			        clip-rule="evenodd"
			      />
			    </svg>
			
			    <span>Plans</span>
			  </a>
			
			
			  <!-- SETTINGS -->
			  <a href="#">
			
			    <svg
			      xmlns="http://www.w3.org/2000/svg"
			      viewBox="0 0 24 24"
			      fill="currentColor"
			    >
			      <path d="M17.004 10.407c.138.435-.216.842-.672.842h-3.465a.75.75 0 0 1-.65-.375l-1.732-3c-.229-.396-.053-.907.393-1.004a5.252 5.252 0 0 1 6.126 3.537Z"/>
			
