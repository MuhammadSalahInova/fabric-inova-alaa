	/// Average discount percentage grouped by product category
	measure 'Avg Discount Per Category' =
			
			AVERAGEX(
			    orders,
			    orders[Discount]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: da60a893-c185-44bc-9c79-139d7f8cf2f0

	/// KPI card displaying average order value (Total Revenue divided by Total Orders), shown as a styled HTML card with an animated gradient
	measure KPI_AvgOrderValue =
			
			VAR _val = DIVIDE([Total Revenue], [Total Orders])
			VAR _fmt =
			    SWITCH(
			        TRUE(),
			        _val >= 1000000, FORMAT(DIVIDE(_val,1000000),"0.00") & "M",
			        _val >= 1000, FORMAT(DIVIDE(_val,1000),"0") & "K",
			        FORMAT(_val,"0")
			    )
			VAR _html =
			"<style>
			.kpi-card {
			  position: relative;
			  background: #FFFFFF;
			  border-radius: 12px;
			  padding: 20px;
			  box-sizing: border-box;
			  height: 100%;
			  display: flex;
			  flex-direction: column;
			  justify-content: center;
			  gap: 6px;
			  font-family: Arial, sans-serif;
			  animation: glowPulse 4s ease-in-out infinite;
			}
			@keyframes glowPulse {
			  0% { box-shadow: 0 0 34px 6px rgba(34,211,238,0.55); }
			  33% { box-shadow: 0 0 34px 6px rgba(139,92,246,0.55); }
			  66% { box-shadow: 0 0 34px 6px rgba(236,72,153,0.55); }
			  100% { box-shadow: 0 0 34px 6px rgba(34,211,238,0.55); }
			}
			.kpi-icon {
			  position: absolute;
			  top: 14px;
			  right: 16px;
			  width: 34px;
			  height: 34px;
			  animation: bounceIcon 2.2s ease-in-out infinite;
			}
			@keyframes bounceIcon {
			  0%, 100% { transform: translateY(0); }
			  50% { transform: translateY(-6px); }
			}
			.kpi-label {
			  font-size: 30px;
			  color: #4A4F63;
			}
			.kpi-value {
			  font-size: 34px;
			  font-weight: 700;
			  background: linear-gradient(90deg, #22D3EE, #8B5CF6, #EC4899, #8B5CF6, #22D3EE);
			  background-size: 300% 100%;
			  -webkit-background-clip: text;
			  background-clip: text;
			  color: transparent;
			  animation: gradientShift 6s ease-in-out infinite;
			}
			@keyframes gradientShift {
			  0% { background-position: 0% 50%; }
			  50% { background-position: 100% 50%; }
			  100% { background-position: 0% 50%; }
			}
			</style>
			<div class='kpi-card'>
			  <svg class='kpi-icon' viewBox='0 0 24 24'>
			    <defs>
			      <linearGradient id='g2' x1='0' y1='0' x2='1' y2='1'>
			        <stop offset='0%' stop-color='#22D3EE'/>
			        <stop offset='50%' stop-color='#8B5CF6'/>
			        <stop offset='100%' stop-color='#EC4899'/>
			      </linearGradient>
			    </defs>
			    <path fill='none' stroke='url(#g2)' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' d='M3 3v18h18M7 14l3-3 3 3 5-6'/>
			  </svg>
			  <span class='kpi-label'>Avg Order Value</span>
			  <span class='kpi-value'>" & _fmt & "</span>
			</div>"
			RETURN _html
		lineageTag: b0a0dc88-d37d-4ec3-92ef-a98245841ff5

	/// Duplicate of KPI_AvgOrderValue (average order value = Total Revenue / Total Orders) styled with a dark background for the dark theme version of the report
