			.glass-btn-outer {
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  padding: 3px;
			  border-radius: 999px;
			  background: linear-gradient(90deg, #22D3EE, #8B5CF6, #EC4899, #8B5CF6, #22D3EE);
			  background-size: 300% 100%;
			  animation: gradientShift 6s ease-in-out infinite;
			}
			@keyframes gradientShift {
			  0% { background-position: 0% 50%; }
			  50% { background-position: 100% 50%; }
			  100% { background-position: 0% 50%; }
			}
			.glass-btn-inner {
			  width: 100%;
			  height: 100%;
			  box-sizing: border-box;
			  background: #1A1E30;
			  border-radius: 999px;
			  display: flex;
			  align-items: center;
			  justify-content: center;
			  gap: 14px;
			  padding: 8px 16px;
			}
			.glass-btn-inner a {
			  display: flex;
			  align-items: center;
			  gap: 10px;
			  color: #FFFFFF;
			  text-decoration: none;
			  min-width: 0;
			}
			.glass-btn-inner svg {
			  width: 36px;
			  height: 36px;
			  flex-shrink: 0;
			  fill: currentColor;
			}
			.glass-btn-inner span {
			  font-family: Arial, sans-serif;
			  font-size: 19px;
			  font-weight: 700;
			  line-height: 1;
			  white-space: nowrap;
			  overflow: hidden;
